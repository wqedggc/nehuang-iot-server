# ============================================================================
# 涅凰智农 IoT 云平台 — 环境变量配置模板
# ============================================================================
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 编辑 .env，填入实际值
#   3. 运行部署脚本：       ./deploy.sh
# ============================================================================

# JWT 密钥（生产环境请修改为随机字符串，建议 32 位以上）
NEHUANG_JWT_SECRET=nehuang-dev-secret-change-me

# 管理员初始密码（部署时使用，部署后建议通过接口修改）
NEHUANG_ADMIN_PASSWORD=admin123

# Adapter API 认证 token（Mock 脚本和 Gateway 上报设备事件时使用）
NEHUANG_ADAPTER_TOKEN=nehuang-adapter-dev-token

# Gateway Adapter TCP 接入和下行命令配置
NEHUANG_GATEWAY_TCP_ADDR=:8081
NEHUANG_GATEWAY_HEALTH_ADDR=:18081
NEHUANG_GATEWAY_API_BASE_URL=http://127.0.0.1:8080
NEHUANG_GATEWAY_RAW_LOG_DIR=data/gateway-adapter/raw-frames
NEHUANG_GATEWAY_RAW_LOG_MAX_BYTES=67108864
NEHUANG_GATEWAY_RAW_REPLAY_INTERVAL_SECONDS=5
NEHUANG_GATEWAY_RAW_REPLAY_BATCH=100
NEHUANG_GATEWAY_RAW_DISK_MAX_USED_PERCENT=90
NEHUANG_GATEWAY_RAW_RETENTION_DAYS=14
NEHUANG_GATEWAY_RAW_PRUNE_INTERVAL_SECONDS=3600
NEHUANG_GATEWAY_DEBUG=false
NEHUANG_GATEWAY_COMMAND_POLL_INTERVAL_SECONDS=2
NEHUANG_GATEWAY_COMMAND_POLL_LIMIT=20
NEHUANG_GATEWAY_COMMAND_WRITE_TIMEOUT_SECONDS=5

# 微信小程序登录配置（真实 AppSecret 只允许写入服务器 .env，禁止提交到代码库）
NEHUANG_WECHAT_APPID=wx_your_mini_program_appid
NEHUANG_WECHAT_SECRET=your_wechat_app_secret
NEHUANG_ENABLE_MOCK_LOGIN=false

# MySQL 配置（根据服务器实际情况修改）
NEHUANG_MYSQL_USER=root
NEHUANG_MYSQL_PASSWORD=your_mysql_password
NEHUANG_MYSQL_HOST=127.0.0.1
NEHUANG_MYSQL_PORT=3306
NEHUANG_MYSQL_DATABASE=nehuang_db

# 离线扫描配置（默认开启，超过 35 秒未上报则标记离线）
NEHUANG_OFFLINE_SCAN_ENABLED=true
NEHUANG_OFFLINE_THRESHOLD_SECONDS=35
NEHUANG_OFFLINE_SCAN_INTERVAL_SECONDS=10

# MySQL Unix Socket 路径（可选）
# 如果设置了此变量，服务端将通过 Unix Socket 连接 MySQL，而非 TCP host:port
# 常见于腾讯云默认安装的 MySQL，socket 路径通常为：
#   /var/lib/mysql/mysql.sock        (CentOS/RHEL)
#   /var/run/mysqld/mysqld.sock      (Ubuntu/Debian)
# 留空则使用上方 host:port 进行 TCP 连接
#NEHUANG_MYSQL_SOCKET=/var/lib/mysql/mysql.sock
